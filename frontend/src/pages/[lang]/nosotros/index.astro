---
import Navbar from '../../../components/shared/Navbar.astro';
import Footer from '../../../components/shared/Footer.astro';
import { getTranslation, languages, type SupportedLang } from '../../../i18n';
import '../../../styles/global.css';
import GoogleAnalytics from '../../../components/shared/GoogleAnalytics.astro';
import SEOHead from '../../../components/SEO/SEOHead.astro';

const { lang } = Astro.params;
const currentLang = (Object.keys(languages).includes(lang as string) ? lang : 'es') as SupportedLang;
const t = getTranslation(currentLang);

interface AboutContent {
  title: string;
  subtitle: string;
  paragraphs: string[];
}

const aboutData: Record<SupportedLang, AboutContent> = {
  es: {
    title: "INCA’S PARADISE",
    subtitle: "Más allá del destino, el arte de descubrir el mundo de otra manera.",
    paragraphs: [
      "Hay viajes que nos llevan a lugares extraordinarios y experiencias que nos acercan a la esencia de una cultura, transformando nuestra manera de ver el mundo.",
      "En INCA’S PARADISE, concebimos cada viaje como una experiencia profundamente personal, donde la exclusividad se expresa en los detalles, la autenticidad cobra vida en cada encuentro y el verdadero lujo reside en descubrir cada destino de una manera única y significativa.",
      "Especialistas en viajes a medida por Perú y Bolivia, diseñamos experiencias que revelan la riqueza de sus paisajes, culturas y tradiciones: desde la majestuosidad de los Andes y el legado de antiguas civilizaciones hasta la exuberancia de la Amazonía y las tradiciones vivas de sus comunidades.",
      "Combinamos conocimiento local, sensibilidad cultural y una cuidada selección de experiencias, alojamientos y servicios para crear itinerarios únicos, adaptados a los intereses de cada viajero y concebidos para armonizar confort, descubrimiento y una conexión auténtica e inmersiva con el entorno y sus comunidades.",
      "Creemos que el lujo más memorable consiste en descubrir un lugar a través de quienes lo habitan, compartir encuentros auténticos y vivir momentos que trascienden el viaje y permanecen en la memoria.",
      "En INCA’S PARADISE, cada viaje se diseña con dedicación, se distingue por una atención excepcional a los detalles y se convierte en una experiencia verdaderamente personal.",
    ],
  },
  en: {
    title: "INCA’S PARADISE",
    subtitle: "Beyond the destination, a different way to discover the world.",
    paragraphs: [
      "Some journeys take us to extraordinary places. Others bring us closer to the essence of a culture, transforming the way we see the world.",
      "At INCA’S PARADISE, we believe every journey should be deeply personal. Exclusivity lies in the details, authenticity comes to life through meaningful encounters, and true luxury lies in discovering each destination in a unique and meaningful way.",
      "Specialists in tailor-made journeys across Peru and Bolivia, we create experiences that reveal the richness of their landscapes, cultures, and traditions—from the grandeur of the Andes and the legacy of ancient civilizations to the lush Amazon rainforest and the living traditions of local communities.",
      "We combine local expertise, cultural sensitivity, and a carefully curated selection of experiences, accommodations, and services to craft distinctive itineraries shaped around each traveller’s interests. Every journey is designed to balance comfort and discovery while fostering genuine, immersive connections with the surrounding landscapes and local communities.",
      "We believe the most memorable form of luxury lies in discovering a place through the people who call it home, sharing authentic encounters, and experiencing moments that stay with us long after the journey ends.",
      "At INCA’S PARADISE, every journey is thoughtfully designed, distinguished by exceptional attention to detail, and shaped into an experience that is entirely your own.",
    ],
  },
  pt: {
    title: "INCA’S PARADISE",
    subtitle: "Além do destino, a arte de descobrir o mundo de uma forma diferente.",
    paragraphs: [
      "Há viagens que nos levam a lugares extraordinários e experiências que nos aproximam da essência de uma cultura, transformando a nossa maneira de ver o mundo.",
      "Na INCA’S PARADISE, concebimos cada viagem como uma experiência profundamente pessoal, em que a exclusividade se revela nos detalles, a autenticidade ganha vida em cada encontro e o verdadeiro luxo está em descobrir cada destino de uma forma única e significativa.",
      "Especialistas em viagens personalizadas pelo Peru e pela Bolívia, criamos experiências que revelam a riqueza das paisagens, culturas e tradições desses territórios: da imponência dos Andes e do legado de antigas civilizações à exuberância da Amazónia e às tradições vivas das comunidades locais.",
      "Combinamos conhecimento local, sensibilidade cultural e uma seleção criteriosa de experiências, alojamentos e serviços para criar itinerários únicos, adaptados aos interesses de cada viajante. Cada viagem é pensada para equilibrar conforto e descoberta, promovendo uma ligação genuína e imersiva com a natureza, os lugares e as comunidades.",
      "Acreditamos que o luxo mais memorável está em conhecer um lugar através de quem nele vive, partilhar encontros autênticos e viver momentos que vão além da viagem e permanecem na memória.",
      "Na INCA’S PARADISE, cada viagem é cuidadosamente concebida, distingue-se pela atenção excecional aos detalhes e transforma-se numa experiência verdadeiramente pessoal.",
    ],
  },
  fr: {
    title: "INCA’S PARADISE",
    subtitle: "Au-delà de la destination, l’art de découvrir le monde autrement.",
    paragraphs: [
      "Il y a des voyages qui nous mènent vers des lieux extraordinaires et des expériences qui nous rapprochent de l'essence d'une culture, transformant notre manière de voir le monde.",
      "Chez INCA’S PARADISE, nous concevons chaque voyage comme une expérience profondément personnelle, où l'exclusivité s'exprime dans les détails, l'authenticité prend vie à chaque rencontre et le véritable luxe réside dans la découverte de chaque destination de manière unique et significative.",
      "Spécialistes des voyages sur mesure au Pérou et en Bolivie, nous concevons des expériences qui révèlent la richesse de leurs paysages, cultures et traditions : de la majesté des Andes et de l'héritage des civilisations anciennes à l'exubérance de l'Amazonie et aux traditions vivantes de leurs communautés.",
      "Nous allions expertise locale, sensibilité culturelle et une sélection soignée d'expériences, d'hébergements et de services pour créer des itinéraires uniques, adaptés aux intérêts de chaque voyageur et conçus pour harmoniser confort, découverte et connexion authentique et immersive avec l'environnement et ses communautés.",
      "Nous croyons que le luxe le plus mémorable consiste à découvrir un lieu à travers ceux qui l'habitent, à partager des rencontres authentiques et à vivre des moments qui transcendent le voyage et restent gravés dans la mémoire.",
      "Chez INCA’S PARADISE, chaque voyage est pensé avec dévouement, se distingue par une attention exceptionnelle portée aux détails et devient une expérience véritablement personnelle.",
    ],
  },
  it: {
    title: "INCA’S PARADISE",
    subtitle: "Oltre la destinazione, l’arte di scoprire il mondo in modo diverso.",
    paragraphs: [
      "Ci sono viaggi che ci portano in luoghi straordinari ed esperienze che ci avvicinano all'essenza di una cultura, transformando il nostro modo di vedere il mondo.",
      "In INCA’S PARADISE, concepiamo ogni viaggio come un'esperienza profondamente personale, dove l'esclusività si esprime nei dettagli, l'autenticità prende vita in ogni incontro e il vero lusso risiede nello scoprire ogni destinazione in modo unico e significativo.",
      "Specialisti in viaggi su misura in Perù e Bolivia, creiamo esperienze che rivelano la ricchezza dei loro paesaggi, culture e tradizioni: dalla maestosità delle Ande e dall'eredità delle antiche civiltà fino all'esuberanza dell'Amazzonia e alle tradizioni vive delle loro comunità.",
      "Combiniamo conoscenza locale, sensibilità culturale e un'accurata selezione di esperienze, alloggi e servizi per creare itinerari unici, modellati sugli interessi di ogni viaggiatore e concepiti per armonizzare comfort, scoperta e una connessione autentica e immersiva con l'ambiente e le sue comunità.",
      "Crediamo che il lusso più memorabile consista nello scoprire un luogo attraverso chi lo abita, condividere incontri autentici e vivere momenti che trascendono il viaggio e rimangono impressi nella memoria.",
      "In INCA’S PARADISE, ogni viaggio viene disegnato con dedizione, si distingue per un'eccezionale attenzione ai dettagli e si trasforma in un'esperienza davvero personale.",
    ],
  },
};

const content = aboutData[currentLang] ?? aboutData.es;

const siteOrigin = (Astro.site?.origin ?? 'https://incasparadise.com').replace(/\/$/, '');
const canonical = `${siteOrigin}/${currentLang}/nosotros`;
const alternateLanguages = [
  { lang: 'es', url: `${siteOrigin}/es/nosotros` },
  { lang: 'en', url: `${siteOrigin}/en/nosotros` },
  { lang: 'pt', url: `${siteOrigin}/pt/nosotros` },
  { lang: 'fr', url: `${siteOrigin}/fr/nosotros` },
  { lang: 'it', url: `${siteOrigin}/it/nosotros` },
];

const seoTitle = `${content.title} | ${currentLang === 'es' ? 'Nosotros' : currentLang === 'en' ? 'About Us' : currentLang === 'pt' ? 'Sobre Nós' : currentLang === 'fr' ? 'À Propos' : 'Chi Siamo'}`;
const seoDescription = content.subtitle;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": content.title,
  "description": content.subtitle,
  "url": canonical,
  "inLanguage": currentLang === 'es' ? 'es-PE' : currentLang,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Inca's Paradise",
    "url": siteOrigin,
  },
};
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <SEOHead
      title={seoTitle}
      description={seoDescription}
      canonical={canonical}
      currentLang={currentLang}
      alternateLanguages={alternateLanguages}
      xDefaultUrl={`${siteOrigin}/es/nosotros`}
      structuredData={pageSchema}
    />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafaf9] text-gray-900" data-navbar-solid>
    <Navbar {t} currentLang={currentLang} />

    <main class="flex-1 pt-28 pb-20 md:pt-32 md:pb-24">
      <div class="mx-auto max-w-4xl px-6 sm:px-8">
        <!-- Encabezado Principal -->
        <header class="text-center mb-10 md:mb-12">
          <h1
            class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-wider text-[#132c3f]"
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;"
          >
            {content.title}
          </h1>
          <p
            class="mt-3 md:mt-4 text-lg sm:text-xl md:text-2xl text-stone-600 italic font-serif"
            style="font-family: 'Playfair Display', Georgia, serif;"
          >
            {content.subtitle}
          </p>
        </header>

        <!-- Galería de 2 Fotografías -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 my-8 md:my-12">
          <div class="relative overflow-hidden rounded-2xl shadow-md group aspect-[4/3] bg-stone-200">
            <img
              src="/images/nosotros/nosotros-comunidad.jpg"
              alt="Tradición y cultura local con Inca's Paradise"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </div>
          <div class="relative overflow-hidden rounded-2xl shadow-md group aspect-[4/3] bg-stone-200">
            <img
              src="/images/nosotros/nosotros-experiencia.jpg"
              alt="Experiencias y rutas de aventura con Inca's Paradise"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </div>
        </section>

        <!-- Bloque de Texto -->
        <article class="space-y-6 md:space-y-7 text-[#2b2f33] text-base sm:text-lg leading-relaxed sm:leading-8 font-normal">
          {content.paragraphs.map((paragraph) => (
            <p class="text-justify sm:text-left">
              {paragraph}
            </p>
          ))}
        </article>
      </div>
    </main>

    <Footer {t} currentLang={currentLang} />
  </body>
</html>
