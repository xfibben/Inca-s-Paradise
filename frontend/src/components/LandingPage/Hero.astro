---
interface Props {
  t: any;
}

const { t } = Astro.props;
---

<!-- Hero superpuesto con imagen específica para móviles -->
<section class="relative h-[100dvh] w-full overflow-hidden bg-black">
  <!-- Image Carousel Background -->
  <div id="hero-carousel" class="absolute inset-0 h-full w-full overflow-hidden bg-black">
    <!-- First image: loaded immediately -->
    <img
      src="/landing page images/wallpaper1-mobile.jpg"
      alt="Experiencias culturales en Perú y Bolivia"
      class="hero-image absolute inset-0 h-full w-full object-cover object-center opacity-100 transition-opacity duration-1000 md:hidden"
      data-index="0"
      width="900"
      height="1600"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <img
      src="/landing page images/wallpaper1.webp"
      alt="Experiencias culturales en Perú y Bolivia"
      class="hero-image absolute inset-0 hidden h-full w-full object-cover object-center opacity-100 transition-opacity duration-1000 md:block"
      data-index="0"
      width="1280"
      height="720"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <!-- segunda imagen: lazy loaded -->
    <img
      data-src="/landing page images/ubicacion-choquequirao-full.webp"
      alt="Choquequirao - Ciudadela inca perdida en Cusco"
      class="hero-image absolute inset-0 hidden h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000 md:block"
      data-index="1"
      width="1280"
      height="853"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/40"></div>

    <!-- Carousel Indicators -->
    <div class="absolute bottom-8 left-1/2 z-20 hidden -translate-x-1/2 gap-3 md:flex">
      <button class="hero-dot h-3 w-3 rounded-full bg-white/70 hover:bg-white transition-all duration-300" data-index="0" aria-label="Ir a imagen 1"></button>
      <button class="hero-dot hidden h-3 w-3 rounded-full bg-white/40 transition-all duration-300 hover:bg-white/70 md:block" data-index="1" aria-label="Ir a imagen 2"></button>
    </div>
  </div>

  <!-- Content -->
  <div class="absolute inset-0 z-10 flex h-full -translate-y-16 flex-col items-center justify-center px-5 py-8 text-center md:-translate-y-16 md:px-4 md:py-0">

    <!-- Main Heading -->
    <h1 class="mb-5 max-w-4xl font-serif text-4xl leading-tight text-white md:mb-9 md:text-4xl lg:text-5xl" style="font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;">
      {t.hero.mainTitle}
    </h1>

    <!-- Subheading -->
    <p class="mb-32 max-w-3xl whitespace-pre-line text-base leading-relaxed text-white/90 sm:text-lg md:mb-28 md:text-xl lg:text-2xl">
      {t.hero.subtitle}
    </p>

    <!-- CTA Button -->
    <button id="hero-cta" class="border-2 border-white px-8 py-3 text-base font-semibold text-white transition-all duration-300 hover:bg-white hover:text-gray-900 md:px-10 md:py-4 md:text-lg">
      {t.hero.cta}
    </button>
  </div>
</section>

<script is:inline>
  // Hero Image Carousel
  let currentImageIndex = 0;
  const desktopHeroMedia = window.matchMedia('(min-width: 768px)');
  const carouselInterval = 5000; // 5 segundos para dejar cada imagen estable y nítida
  let imageCarouselTimer;
  let secondaryImageLoaded = false;

  function ensureSecondaryImageLoaded() {
    if (!desktopHeroMedia.matches || secondaryImageLoaded) return;
    const secondImage = document.querySelector('.hero-image[data-index="1"]');
    if (!secondImage) return;
    const pendingSrc = secondImage.getAttribute('data-src');
    if (!pendingSrc) return;
    secondImage.setAttribute('src', pendingSrc);
    secondImage.removeAttribute('data-src');
    secondaryImageLoaded = true;
  }

  function showHeroImage(index) {
    const totalImages = desktopHeroMedia.matches ? 2 : 1;
    if (index >= totalImages) index = 0;
    currentImageIndex = index;
    const images = document.querySelectorAll('.hero-image');
    const dots = document.querySelectorAll('.hero-dot');
    
    images.forEach((img) => {
      if (Number(img.getAttribute('data-index')) === index) {
        img.classList.remove('opacity-0');
        img.classList.add('opacity-100');
      } else {
        img.classList.remove('opacity-100');
        img.classList.add('opacity-0');
      }
    });

    dots.forEach((dot) => {
      if (Number(dot.getAttribute('data-index')) === index) {
        dot.classList.add('bg-white');
        dot.classList.remove('bg-white/40');
      } else {
        dot.classList.remove('bg-white');
        dot.classList.add('bg-white/40');
      }
    });
  }

  function nextHeroImage() {
    ensureSecondaryImageLoaded();
    const totalImages = desktopHeroMedia.matches ? 2 : 1;
    currentImageIndex = (currentImageIndex + 1) % totalImages;
    showHeroImage(currentImageIndex);
  }

  function startImageCarousel() {
    stopImageCarousel();
    if (!desktopHeroMedia.matches) return;
    imageCarouselTimer = setInterval(nextHeroImage, carouselInterval);
  }

  function stopImageCarousel() {
    clearInterval(imageCarouselTimer);
  }

  // Scroll a destinos al hacer click en CTA
  document.getElementById('hero-cta').addEventListener('click', () => {
    document.getElementById('destinos').scrollIntoView({ behavior: 'smooth' });
  });

  // Start carousel on load
  showHeroImage(currentImageIndex);
  startImageCarousel();

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => ensureSecondaryImageLoaded(), { timeout: 3500 });
  } else {
    setTimeout(() => ensureSecondaryImageLoaded(), 2500);
  }

  desktopHeroMedia.addEventListener('change', () => {
    currentImageIndex = 0;
    showHeroImage(currentImageIndex);
    if (desktopHeroMedia.matches) ensureSecondaryImageLoaded();
    startImageCarousel();
  });

  // Add click handlers to dots
  document.querySelectorAll('.hero-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      ensureSecondaryImageLoaded();
      currentImageIndex = parseInt(dot.getAttribute('data-index'));
      showHeroImage(currentImageIndex);
      // Reset timer when user clicks
      stopImageCarousel();
      startImageCarousel();
    });
  });

  // Pause carousel on hover and resume on leave
  const heroCarousel = document.getElementById('hero-carousel');
  if (heroCarousel) {
    heroCarousel.addEventListener('mouseenter', stopImageCarousel);
    heroCarousel.addEventListener('mouseleave', startImageCarousel);
  }
</script>
