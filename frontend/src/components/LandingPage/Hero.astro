---
interface Props {
  t: any;
}

const { t } = Astro.props;
---

<!-- Hero: dividido en móviles y superpuesto desde tablet -->
<section class="relative mt-24 w-full min-h-[calc(100dvh-6rem)] overflow-hidden bg-[#f8f4ee] md:mt-0 md:h-screen md:min-h-0 md:bg-transparent">
  <!-- Image Carousel Background -->
  <div id="hero-carousel" class="relative aspect-[16/9] w-full overflow-hidden bg-black md:absolute md:inset-0 md:h-full md:aspect-auto">
    <!-- First image: loaded immediately -->
    <img
      src="/landing page images/wallpaper1.webp"
      alt="Aventuras personalizadas en Perú - Machu Picchu y Los Andes"
      class="hero-image absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000 opacity-100"
      data-index="0"
      width="1280"
      height="720"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <!-- segunda imagen: lazy loaded -->
    <img
      data-src="/landing page images/ubicacion-choquequirao-full.webp"
      alt="Choquequirao - Ciudadela inca perdida en Cusco"
      class="hero-image absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000 opacity-0"
      data-index="1"
      width="1280"
      height="853"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
    />
    <!-- Overlay limitado a la imagen en móviles -->
    <div class="absolute inset-0 bg-black/25 md:bg-black/40"></div>

    <!-- Carousel Indicators -->
    <div class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 gap-3 md:bottom-8">
      <button class="hero-dot h-3 w-3 rounded-full bg-white/70 hover:bg-white transition-all duration-300" data-index="0" aria-label="Ir a imagen 1"></button>
      <button class="hero-dot h-3 w-3 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300" data-index="1" aria-label="Ir a imagen 2"></button>
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center justify-start px-5 py-8 text-center md:absolute md:inset-0 md:h-full md:px-4 md:py-0 md:pt-30">

    <!-- Main Heading -->
    <h1 class="mb-4 max-w-4xl font-serif text-3xl leading-tight text-[#178f86] md:mb-16 md:text-3xl md:text-white lg:text-4xl" style="font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;">
      {t.hero.mainTitle}
    </h1>

    <!-- Subheading -->
    <p class="mb-6 max-w-3xl text-sm leading-relaxed text-gray-700 sm:text-base md:mb-16 md:text-lg md:text-white/90 lg:text-xl">
      {t.hero.subtitle}
    </p>

    <!-- CTA Button -->
    <button id="hero-cta" class="border-2 border-[#178f86] px-8 py-3 text-base font-semibold text-[#178f86] transition-all duration-300 hover:bg-[#178f86] hover:text-white md:border-white md:px-10 md:py-4 md:text-lg md:text-white md:hover:bg-white md:hover:text-gray-900">
      {t.hero.cta}
    </button>
  </div>
</section>

<script is:inline>
  // Hero Image Carousel
  let currentImageIndex = 0;
  const totalImages = 2;
  const carouselInterval = 5000; // 5 segundos para dejar cada imagen estable y nítida
  let imageCarouselTimer;
  let secondaryImageLoaded = false;

  function ensureSecondaryImageLoaded() {
    if (secondaryImageLoaded) return;
    const secondImage = document.querySelector('.hero-image[data-index="1"]');
    if (!secondImage) return;
    const pendingSrc = secondImage.getAttribute('data-src');
    if (!pendingSrc) return;
    secondImage.setAttribute('src', pendingSrc);
    secondImage.removeAttribute('data-src');
    secondaryImageLoaded = true;
  }

  function showHeroImage(index) {
    const images = document.querySelectorAll('.hero-image');
    const dots = document.querySelectorAll('.hero-dot');
    
    images.forEach((img, i) => {
      if (i === index) {
        img.classList.remove('opacity-0');
        img.classList.add('opacity-100');
      } else {
        img.classList.remove('opacity-100');
        img.classList.add('opacity-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-white');
        dot.classList.remove('bg-white/40');
      } else {
        dot.classList.remove('bg-white');
        dot.classList.add('bg-white/40');
      }
    });
  }

  function nextHeroImage() {
    ensureSecondaryImageLoaded();
    currentImageIndex = (currentImageIndex + 1) % totalImages;
    showHeroImage(currentImageIndex);
  }

  function startImageCarousel() {
    imageCarouselTimer = setInterval(nextHeroImage, carouselInterval);
  }

  function stopImageCarousel() {
    clearInterval(imageCarouselTimer);
  }

  // Scroll a destinos al hacer click en CTA
  document.getElementById('hero-cta').addEventListener('click', () => {
    document.getElementById('destinos').scrollIntoView({ behavior: 'smooth' });
  });

  // Start carousel on load
  showHeroImage(currentImageIndex);
  startImageCarousel();

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => ensureSecondaryImageLoaded(), { timeout: 3500 });
  } else {
    setTimeout(() => ensureSecondaryImageLoaded(), 2500);
  }

  // Add click handlers to dots
  document.querySelectorAll('.hero-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      ensureSecondaryImageLoaded();
      currentImageIndex = parseInt(dot.getAttribute('data-index'));
      showHeroImage(currentImageIndex);
      // Reset timer when user clicks
      stopImageCarousel();
      startImageCarousel();
    });
  });

  // Pause carousel on hover and resume on leave
  const heroCarousel = document.getElementById('hero-carousel');
  if (heroCarousel) {
    heroCarousel.addEventListener('mouseenter', stopImageCarousel);
    heroCarousel.addEventListener('mouseleave', startImageCarousel);
  }
</script>
