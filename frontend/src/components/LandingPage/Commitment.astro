---
interface Props {
  t: any;
}

const { t } = Astro.props;
---

<!-- Commitment Section -->
<section class="bg-gradient-to-b from-slate-900 to-slate-800 flex items-center justify-center py-12 md:py-16 lg:py-20">
  <div class="w-full text-center px-4 md:px-8">
    <!-- Testimonial Text -->
    <blockquote class="mb-8 md:mb-12">
      <p class="mb-8 text-lg italic leading-relaxed text-white md:text-2xl lg:text-3xl" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        "{t.commitment.text}"
      </p>
    </blockquote>
  </div>
</section>
